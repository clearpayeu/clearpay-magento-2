<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <head>
        <css src="Clearpay_Clearpay::css/clearpay-checkout.css"/>
        <script src="Clearpay_Clearpay::js/hyva-checkout-title-replacer.js" defer="defer"/>
    </head>
    <body>
        <referenceBlock name="clearpay.cta.mini.cart.headless" remove="true"/>
        <referenceBlock name="clearpay.minicart.express.checkout.headless" remove="true"/>
        <referenceBlock name="head.components">
            <block name="clearpay.widget.checkout.cart.lib" template="Clearpay_Clearpay::express-checkout/lib.phtml" before="-" >
                <arguments>
                    <argument name="view_model" xsi:type="object">Clearpay\Clearpay\ViewModel\WidgetCheckout\Lib</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
